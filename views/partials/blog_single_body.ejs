<div class="container">
    <div class="row">
        <div class="card mt-3 border-0">
            <div class="d-flex">
                <img class="w-25 card-img" src="/assets/images/blog/<%= blog_single_Data.image _%>.jpg"
                    alt="Card image cap">
                <div class=" card-body">
                    <h3 class="card-title text-capitalize">
                        <%= blog_single_Data.title _%>
                    </h3>
                    <p class="card-text">
                        <%= blog_single_Data.body _%>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>