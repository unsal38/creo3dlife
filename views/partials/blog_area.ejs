              <div id="blog" class="latest-news-area section">
                <!--======  Start Section Title Five ======-->
                <div class="section-title-five">
                  <div class="container">
                    <div class="row">
                      <div class="col-12">
                        <div class="content">
                          <h6><a href="/blog">Blog Sayfası</a></h6>
                          <h2 class="fw-bold text-capitalize">son haberler & Blog</h2>
                          <p>
                            Son gelişmeler ve haberler ile size en doğru bilgiyi vermek...
                          </p>
                        </div>
                      </div>
                    </div>
                    <!-- row -->
                  </div>
                  <!-- container -->
                </div>
                <!--======  End Section Title Five ======-->



                <div class="container">
                  <div class="row">
                    <!-- Swiper SLİDE BLOG -->
                    <div class="swiper mySwiper">
                      <div class="swiper-wrapper">
                        <% blog_data.forEach(v_blog => {%>
                          
                        
                        <div class="swiper-slide">
                          <div class="single-news">
                            <div class="image">
                              <a href="/blog/blog-single/<%= v_blog._id _%>"><img class="thumb" src="assets/images/blog/<%= v_blog.image _%>.jpg"
                                  alt="Blog" /></a>
                              <!-- <div class="meta-details">
                                <img class="thumb" src="assets/images/blog/b6.jpg" alt="Author" />
                                <span>BY TIM NORTON</span>
                              </div> -->
                            </div>
                            <div class="content-body">
                              <h4 class="title">
                                <a href="/blog/blog-single/<%= v_blog._id _%>"> <%= v_blog.title _%> </a>
                              </h4>
                              <p class="uc_nokta">
                                <%= v_blog.body _%>
                              </p>
                            </div>
                          </div>
                        </div>


                        <% }); %> 

                      </div>
                      <div class="swiper-pagination"></div>
                    </div>
                  </div>
                </div>
              </div>